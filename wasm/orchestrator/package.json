{
  "name": "zang-orchestrator",
  "version": "1.0.0",
  "description": "TypeScript orchestrator for multi-agent AI development system",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zang-org": "dist/cli.js",
    "zang-notify": "dist/notify-cli.js",
    "zang-watcher": "dist/watcher-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "watcher": "tsx src/watcher-cli.ts",
    "notify": "tsx src/notify-cli.ts",
    "test:notify": "bash test-notify/run-test.sh --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "orchestrator",
    "tmux",
    "multi-agent"
  ],
  "author": "Zang Project",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
